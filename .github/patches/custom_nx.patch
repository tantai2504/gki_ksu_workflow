+static bool ksu_should_hide_context(const char *buf, size_t size)
+{
+    const char * const *p;
+
+    if (!buf || !size)
+        return false;
+
+    for (p = ksu_hidden_type_markers; *p; p++) {
+        if (strnstr(buf, *p, size))
+            return true;
+    }
+    return false;
+}
